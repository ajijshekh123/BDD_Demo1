{
  "name": "playwright-cucumber-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "Extensible BDD test automation framework using Cucumber and Playwright",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:login": "cucumber-js --tags @login",
    "test:login:ui": "cross-env HEADLESS=false cucumber-js --tags @login",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@types/node": "^22.15.0",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.13.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "playwright": "^1.56.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
